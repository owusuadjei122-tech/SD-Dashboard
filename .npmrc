# react is pinned to a 19.0.0 release candidate, and semver excludes
# prereleases from a ^19.0.0 range, so framer-motion's peer dependency
# fails to resolve on a clean install. Local node_modules predates the
# check and works fine; CI installs from scratch and errors out.
#
# Remove this once react and react-dom move to a stable 19.x release.
legacy-peer-deps=true
