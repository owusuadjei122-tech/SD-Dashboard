# Supabase Configuration
# These environment variables are public and safe to expose in the browser
# Replace with your actual Supabase project URL and public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key (only for server-side operations if needed)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: API Keys for third-party services
# Add any other required environment variables here
