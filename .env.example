# Supabase Configuration
# These environment variables are public and safe to expose in the browser
# Replace with your actual Supabase project URL and public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public base URL of this deployment. Used for invitation links, OAuth
# callbacks, and links inside outgoing emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (approval, rejection, invitation, new-login alerts).
# Without these the platform still records every message in `email_outbox`
# and shows invitation links in the admin UI, but nothing is delivered.
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM=SelfDiscovery <no-reply@yourdomain.com>

# Optional: Service Role Key (only for server-side operations if needed)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
